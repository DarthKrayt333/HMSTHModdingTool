<Window x:Class="HMSTHPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HMSTH Asset Preview" Height="780" Width="1120" Loaded="Window_Loaded"
        MinHeight="520" MinWidth="760" WindowStartupLocation="CenterScreen"
        Background="#20242B" Foreground="#E8EAF0">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#2B3039" Padding="10">
            <WrapPanel VerticalAlignment="Center">
                <Button Content="Open OBJ / GLB" Click="OpenModel_Click" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Open Texture Image" Click="OpenTexture_Click" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Open GDTB Archive" Click="OpenGdtb_Click" Margin="0,0,8,0" Padding="12,6" />
                <Button Content="Reset Camera" Click="ResetCamera_Click" Margin="0,0,12,0" Padding="12,6" />
                <TextBlock Text="Drag to rotate · Mouse wheel to zoom" VerticalAlignment="Center" Foreground="#B9C0CC" />
            </WrapPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="#2B3039" Foreground="#D8DCE5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready. Open an OBJ/GLB model, an image, or a GDTB archive." />
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="PreviewTabs" Background="#20242B" Foreground="#20242B" BorderThickness="0">
            <TabItem Header="3D Model">
                <Grid Background="#171A20">
                    <Viewport3D x:Name="ModelViewport" ClipToBounds="True"
                                MouseDown="ModelViewport_MouseDown"
                                MouseMove="ModelViewport_MouseMove"
                                MouseUp="ModelViewport_MouseUp"
                                MouseWheel="ModelViewport_MouseWheel">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="PreviewCamera" Position="0,0,6"
                                               LookDirection="0,0,-6" UpDirection="0,1,0"
                                               FieldOfView="45" NearPlaneDistance="0.01" FarPlaneDistance="1000000" />
                        </Viewport3D.Camera>
                        <ModelVisual3D x:Name="SceneVisual" />
                    </Viewport3D>
                    <Border x:Name="ModelPlaceholder" Background="#B5171A20" Padding="22"
                            HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                            IsHitTestVisible="False">
                        <TextBlock Text="Open an OBJ or GLB model to preview it here."
                                   Foreground="#D7DCE5" FontSize="16" TextAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Texture Image">
                <Grid Background="#171A20">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="TextureImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ScrollViewer>
                    <Border x:Name="ImagePlaceholder" Background="#B5171A20" Padding="22"
                            HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                            IsHitTestVisible="False">
                        <TextBlock Text="Open a BMP, PNG, JPEG, GIF, TIFF or another WPF-decodable image."
                                   Foreground="#D7DCE5" FontSize="15" TextAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="GDTB Textures">
                <Grid Background="#171A20" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Background="#252A32">
                        <TextBlock DockPanel.Dock="Top" x:Name="GdtbSourceText" Text="No GDTB loaded"
                                   Margin="10" Foreground="#D7DCE5" TextWrapping="Wrap" />
                        <ListBox x:Name="GdtbTextureList" SelectionChanged="GdtbTextureList_SelectionChanged"
                                 Background="#252A32" Foreground="#E8EAF0" BorderThickness="0" />
                    </DockPanel>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#444B57" />
                    <Grid Grid.Column="2" Background="#20242B">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" x:Name="GdtbTextureInfo" Margin="8"
                                       Foreground="#D7DCE5" TextWrapping="Wrap" />
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Image x:Name="GdtbTextureImage" Stretch="None"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ScrollViewer>
                        </DockPanel>
                        <TextBlock x:Name="GdtbPlaceholder" Text="Open a GDTB archive and choose a texture."
                                   Foreground="#B9C0CC" FontSize="15" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
